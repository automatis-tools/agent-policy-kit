#!/bin/sh
# Contributor check before a push. It is not packaged, and generated client settings never contain hooks.
# Enable it once per clone: git config core.hooksPath .githooks
set -eu

# Git sends one line per pushed ref: <local ref> <local sha> <remote ref> <remote sha>.
# A deletion has an all-zero local sha, so a push of only deletions needs no check.
updates=0
while read -r _ local_sha _ _; do
  case "$local_sha" in
    *[!0]*) updates=1 ;;
  esac
done
[ "$updates" -eq 1 ] || exit 0

cd "$(git rev-parse --show-toplevel)"
# Git exports GIT_DIR (in a linked worktree) and other repository variables to hooks. Tests that
# create fixture repositories must not inherit them, or their git commands write to this repository.
# shellcheck disable=SC2046
unset $(git rev-parse --local-env-vars)
if [ ! -d node_modules ]; then
  echo 'pre-push: install dependencies first: npm ci --ignore-scripts --no-audit --no-fund' >&2
  exit 1
fi
npm run --silent check
npm run --silent test:unit
