{
  "$schema": "https://unpkg.com/wrangler@4.151.3/config-schema.json",
  "name": "agent-policy-kit",
  "compatibility_date": "2026-10-30",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "routes": [
    {
      "pattern": "agent-policy-kit.trymenow.io",
      "custom_domain": true,
      "zone_name": "trymenow.io"
    }
  ]
}
