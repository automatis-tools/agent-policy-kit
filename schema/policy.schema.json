{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Policy Kit policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "mode", "clients"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "mode": { "enum": ["enforce", "observe"] },
    "clients": {
      "type": "object", "minProperties": 1, "additionalProperties": false,
      "properties": {
        "codex": { "$ref": "#/$defs/client" },
        "claude": { "$ref": "#/$defs/client" },
        "kimi": { "$ref": "#/$defs/client" },
        "agy": { "$ref": "#/$defs/client" }
      }
    }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/\\[\\]-]{0,127}$" },
    "identifiers": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "$ref": "#/$defs/identifier" } },
    "profile": {
      "type": "object", "additionalProperties": false, "required": ["model", "effort", "roles"],
      "properties": {
        "model": { "$ref": "#/$defs/identifier" },
        "providerModel": { "$ref": "#/$defs/identifier" },
        "effort": { "enum": ["low", "medium", "high", null] },
        "roles": { "$ref": "#/$defs/identifiers" }
      }
    },
    "client": {
      "type": "object", "additionalProperties": false,
      "required": ["defaultProfile", "maxConcurrent", "profiles", "deniedModels", "observedModels"],
      "properties": {
        "defaultProfile": { "$ref": "#/$defs/identifier" },
        "maxConcurrent": { "type": "integer", "minimum": 1, "maximum": 32 },
        "profiles": {
          "type": "object", "minProperties": 1, "maxProperties": 16,
          "propertyNames": { "allOf": [{ "$ref": "#/$defs/identifier" }, { "not": { "enum": ["__proto__", "constructor", "prototype"] } }] },
          "additionalProperties": { "$ref": "#/$defs/profile" }
        },
        "deniedModels": { "$ref": "#/$defs/identifiers" },
        "observedModels": { "$ref": "#/$defs/identifiers" }
      }
    }
  },
  "$comment": "The runtime validator also checks default-profile existence, unique models/roles across profiles, and disjoint allowed/denied models."
}
