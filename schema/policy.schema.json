{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Policy Kit configuration preferences",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "maxConcurrent",
    "clients"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "maxConcurrent": {
      "type": "integer",
      "minimum": 1,
      "maximum": 32
    },
    "clients": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "codex": {
          "$ref": "#/$defs/client"
        },
        "claude": {
          "$ref": "#/$defs/client"
        },
        "kimi": {
          "$ref": "#/$defs/kimiClient"
        },
        "agy": {
          "$ref": "#/$defs/tierClient"
        }
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/\\[\\]-]{0,127}$"
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "effort"
      ],
      "properties": {
        "model": {
          "$ref": "#/$defs/identifier"
        },
        "effort": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        }
      }
    },
    "tierProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "effort"
      ],
      "properties": {
        "model": {
          "enum": [
            "pro",
            "flash",
            "inherit"
          ]
        },
        "effort": {
          "type": "null"
        }
      }
    },
    "client": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "light",
        "avoidModels"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/profile"
        },
        "light": {
          "$ref": "#/$defs/profile"
        },
        "avoidModels": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        }
      }
    },
    "tierClient": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "light",
        "avoidModels"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/tierProfile"
        },
        "light": {
          "$ref": "#/$defs/tierProfile"
        },
        "avoidModels": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        }
      }
    },
    "kimiProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "effort"
      ],
      "properties": {
        "model": {
          "allOf": [
            {
              "$ref": "#/$defs/identifier"
            },
            {
              "not": {
                "const": "primary"
              }
            }
          ]
        },
        "effort": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        }
      }
    },
    "kimiClient": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "light",
        "avoidModels"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/kimiProfile"
        },
        "light": {
          "$ref": "#/$defs/kimiProfile"
        },
        "avoidModels": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        }
      }
    }
  },
  "$comment": "The configuration validator also rejects avoided selected models and incompatible efforts for the same Kimi alias."
}
