{
  "name": "agent-policy-kit",
  "version": "0.1.0",
  "description": "Configure native subagent settings across coding tools, then exit",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Mykola Maksymenko",
    "url": "https://www.linkedin.com/in/nick-maximenko/"
  },
  "keywords": [
    "codex",
    "claude-code",
    "kimi",
    "antigravity",
    "subagents",
    "configuration",
    "model-settings"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "bin": {
    "agent-policy": "bin/agent-policy.mjs"
  },
  "files": [
    "bin/",
    "src/",
    "policies/",
    "schema/",
    "examples/",
    "docs/",
    "README.md",
    "AGENT_INSTALL.md",
    "LICENSE",
    "CHANGELOG.md",
    "site/index.html",
    "models/"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "node scripts/check.mjs",
    "test:package": "node --test test/*package*.test.mjs",
    "test:unit": "node scripts/test-unit.mjs",
    "prepublishOnly": "npm run check && npm test",
    "build:site": "node scripts/build-site.mjs",
    "build:host": "npm run build:site && node scripts/build-host.mjs",
    "test:cache": "node scripts/prime-test-cache.mjs"
  },
  "dependencies": {
    "toml-eslint-parser": "1.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/automatis-tools/agent-policy-kit.git"
  },
  "bugs": {
    "url": "https://github.com/automatis-tools/agent-policy-kit/issues"
  },
  "homepage": "https://agent-policy-kit.trymenow.io/v/0.1.0/"
}
